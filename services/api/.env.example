# Salin menjadi .env lalu sesuaikan.
# Semua nilai di bawah adalah default pengembangan — TIDAK ada secret asli di repo.
# Daftar variabel lengkap + aturan validasi: services/api/src/common/config/env.ts

NODE_ENV=development
LOG_LEVEL=info

# Wajib. Harus PostgreSQL (protokol postgres:// atau postgresql://).
DATABASE_URL=postgresql://sera:sera@localhost:5432/sera

# Wajib, minimal 32 karakter
JWT_SECRET=ganti-dengan-random-32-karakter-minimal
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

API_PORT=3000
CORS_ORIGINS=http://localhost:5173

# mqtt:// untuk dev lokal, mqtts:// (TLS) untuk demo/prod.
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=sera-api
MQTT_TOPIC_PREFIX=sera
MQTT_SITE_ID=demo-01

SOLVER_URL=http://localhost:8000
SOLVER_TIMEOUT_MS=30000
SOLVER_MAX_CONCURRENCY=2

TELEMETRY_MAX_SKEW_S=300
TELEMETRY_STALE_S=900
COMMAND_TTL_S=300
COMMAND_ACK_TIMEOUT_S=45
COMMAND_MAX_ATTEMPTS=2
GATE_POSITION_TOLERANCE_PCT=40

PLAN_HORIZON_H=24
PLAN_SLOT_H=1
ESTIMATOR_INTERVAL_S=300
ESTIMATOR_WINDOW_MIN=15
ESTIMATOR_MAX_OBSERVATIONS=500
ESTIMATOR_BATCH_NETWORKS=10
ESTIMATE_STALE_S=900

LEDGER_PERIOD_H=6
LEDGER_GAMMA=0.9
LEDGER_DEBT_MAX_M3=40
LEDGER_SETTLE_INTERVAL_S=600

EXPERIMENT_MAX_RUNS=5000
EXPERIMENT_POLL_INTERVAL_S=10
REFRESH_CLEANUP_INTERVAL_S=3600
REFRESH_TOKEN_RETENTION_D=30
