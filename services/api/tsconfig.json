{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"]
}