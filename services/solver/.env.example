# Umum
SERA_ENV=dev
LOG_LEVEL=info
LOG_FORMAT=console
TZ=UTC

# HTTP internal
SOLVER_HOST=0.0.0.0
SOLVER_PORT=8000
SOLVER_WORKERS=1

# Optimasi
DEFAULT_SOLVER=highs
SCIP_ENABLED=false
PLAN_TIME_LIMIT_S=25

# Eksperimen
EXPERIMENT_MAX_RUNS=5000
EXPERIMENT_MAX_CONCURRENCY=2
EXPERIMENT_RESULTS_DIR=../../experiments/results
SEED_BASE=1000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=false